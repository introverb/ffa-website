# Copy this file to `.env.local` for local dev, and set the same vars on
# your host (Railway / Cloudflare Pages) for production.

# Resend — used by /api/possibilia-submission to email submissions to you.
# 1. Sign up at https://resend.com
# 2. Settings → API Keys → Create API Key (full access for this project)
# 3. Paste the key here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address on submission emails. MUST be on a domain you've
# verified inside Resend (Settings → Domains → Add domain → DNS records).
# For testing without a verified domain, use:
#   Possibilia Submissions <onboarding@resend.dev>
POSSIBILIA_FROM_EMAIL=Possibilia Submissions <submissions@futureaesthetics.foundation>

# Where submissions get sent. Can be your personal email or a shared inbox.
POSSIBILIA_TO_EMAIL=ollipayne182@gmail.com

# --- OURS storefront (/ours/collect) -----------------------------------
# Stripe test-mode secret key. Dashboard → Developers → API keys ("Secret
# key" — starts with "sk_test_" in test mode). Switch to a live key
# (starts "sk_live_") only once the full flow is verified end-to-end.
STRIPE_SECRET_KEY=

# Signing secret for the storefront's webhook. In the Stripe Dashboard:
# Developers → Webhooks → Add endpoint → URL = https://<your-domain>/api/
# storefront-webhook → events: checkout.session.completed and
# checkout.session.expired. Stripe shows the signing secret (starts
# "whsec_") once the endpoint is created — paste it here.
STRIPE_WEBHOOK_SECRET=

# Upstash Redis — stores live sold/reserved state (updated by the
# webhook, read on every page load). Free tier is plenty for this.
# 1. Sign up at https://upstash.com, create a Redis database (any region).
# 2. Database page → REST API section → copy both values below.
# Without these two set, the checkout route refuses to start a
# purchase (fails safe) rather than accept an unrecorded sale.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gates the one-click "mark sold" link sent in the ETH sale email (The
# Pope) — there's no Stripe webhook for that flow, so this is the only
# way that sale actually flips to "Sold" on the site. Any random string
# works; it only ever appears in an email sent to POSSIBILIA_TO_EMAIL.
STOREFRONT_ADMIN_TOKEN=

# --- Footer mailing list (/api/subscribe) -------------------------------
# Resend Audience segment ID that footer signups get added to. Resend's
# dashboard calls the top-level container an "Audience", but the API
# assigns contacts to it via a `segments` array — find the ID under the
# Audience's "Segments" tab (or its dashboard URL: resend.com/audience?
# segmentId=<this>).
RESEND_MAILING_LIST_SEGMENT_ID=

# --- Gallery Membership (/q/join, /api/create-checkout-session) --------
# Recurring monthly Price IDs for the three membership tiers. Created
# via Stripe Dashboard → Products (or the API) — one Product per tier
# with a single recurring monthly Price. Live-mode IDs already live in
# public/membership.html's CONFIG.prices; these are what the backend
# actually uses (the client's priceId is never trusted directly).
PRICE_MYCELIUM=price_...
PRICE_DEUTERIUM=price_...
PRICE_REGOLITH=price_...

# Signing secret for the membership webhook specifically — see the
# comment on app/api/membership-webhook/route.ts for why this is a
# separate var from STRIPE_WEBHOOK_SECRET rather than reusing it.
# Dashboard → Developers → Webhooks → Add endpoint → URL = https://
# <your-domain>/api/membership-webhook → events: checkout.session.
# completed, customer.subscription.created, customer.subscription.
# updated, customer.subscription.deleted.
MEMBERSHIP_WEBHOOK_SECRET=

# Three Resend segments, one per tier, that a member gets added to
# CUMULATIVELY (see segmentIdsForTier in app/api/membership-webhook/
# route.ts for why — Resend Segments are static containers with no
# property-based filtering, so this is what makes "email Regolith
# members" or "email everyone" possible as a single-segment send
# later). A Deuterium member lands in both MYCELIUM and DEUTERIUM; a
# Regolith member lands in all three. Same Audience as the others is
# fine. Resend dashboard → Audience → Segments tab → New segment (x3)
# → copy each ID.
RESEND_MEMBERSHIP_MYCELIUM_SEGMENT_ID=
RESEND_MEMBERSHIP_DEUTERIUM_SEGMENT_ID=
RESEND_MEMBERSHIP_REGOLITH_SEGMENT_ID=

# --- OURS door check-in kiosk (/ours/checkin, /api/ours-checkin) --------
# Separate Resend segment (same Audience as above is fine — Segments
# are just groupings within one Audience) for walk-in guests checked in
# at the door. Kept apart from the general mailing list so a post-event
# "thanks for coming to OURS" send doesn't hit the whole newsletter.
# Create it the same way: Resend dashboard → Audience → Segments tab →
# New segment → copy its ID here.
RESEND_OURS_ATTENDEES_SEGMENT_ID=
